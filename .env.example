# Exemplo de configuração sem credenciais reais.
# A aplicação lê variáveis do ambiente do processo com os.getenv().
# Ela NÃO carrega arquivos .env automaticamente; copiar este arquivo para
# .env não ativa a configuração. Exporte as variáveis antes de iniciar a API.

# Banco SQLite: se DATABASE_URL não estiver definida, o código utiliza um
# caminho absoluto para tarefas.db na raiz do projeto.
# O exemplo abaixo é opcional e relativo ao diretório de execução.
# Mantenha-o comentado para preservar o padrão calculado pela aplicação.
# DATABASE_URL=sqlite:///./tarefas.db

# Chave OpenAI opcional. Vazia ou ausente, utiliza o fallback local.
# Nunca coloque uma chave real neste arquivo versionado.
OPENAI_API_KEY=

# Modelo padrão implementado. Um valor explicitamente vazio desabilita a IA.
OPENAI_MODEL=gpt-5-nano

# Timeout padrão de 10 segundos para o transporte HTTP.
# Deve ser um número positivo e finito; não garante a duração total da operação.
OPENAI_TIMEOUT_SECONDS=10
